# EkipTakip — systemd birimi.
#
#   sudo cp deploy/ekiptakip.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ekiptakip
#   systemctl status ekiptakip ; journalctl -u ekiptakip -f
#
# User / WorkingDirectory / ExecStart yollarini kendi kurulumuna gore degistir.

[Unit]
Description=EkipTakip (FastAPI + PostgreSQL)
After=network-online.target postgresql.service
Wants=network-online.target
# Ayni makinede degil de uzak sunucudaysa postgresql.service satirini sil.
Requires=postgresql.service

[Service]
Type=simple
User=efe
Group=efe
WorkingDirectory=/home/efe/projects/teamtracker

# Sirlar burada: EKIPTAKIP_SECRET_KEY, GOOGLE_CLIENT_ID/SECRET, DATABASE_URL.
# Basindaki "-" dosya yoksa acilisi engellemez; ama sirlar olmadan uygulama
# zaten acilmaz (spec/70-guvenlik.md §7). Depo kokundeki .env de okunur.
EnvironmentFile=-/etc/ekiptakip.env

Environment=EKIPTAKIP_ENV=yayin

# Veritabani. Parola icerdigi icin asil deger /etc/ekiptakip.env'de durmali;
# asagidaki yalnizca dosya yoksa gecerli olan yerel varsayilandir.
Environment=DATABASE_URL=postgresql:///ekiptakip

# Iki alan adi ayrimi: app.<alan> mobil siteyi KOKTE servis eder, masaustu
# sayfalari o alan adindan erisilemez. Bos birakirsan tek alan adi modu (/m).
Environment=EKIPTAKIP_HOST_APP=app.polonyum.com
Environment=EKIPTAKIP_HOST_DASHBOARD=dashboard.polonyum.com
Environment=EKIPTAKIP_COOKIE_DOMAIN=.polonyum.com

# --workers 1 SART: agac indeksi surec bellegindedir (00-BASLA.md Karar 2).
# --proxy-headers: TLS cloudflared'de bitiyor, uvicorn'un https'i bilmesi gerekir.
ExecStart=/home/efe/projects/teamtracker/.venv/bin/uvicorn app:app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1

Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

# --- hafif sikilastirma -------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Veritabani artik dosya degil, ayri bir surec: calisma dizinine yazma
# ihtiyaci yok. ProtectSystem=strict'e cikmak istersen once yuklemenin
# gercekten hicbir yere yazmadigini dogrula.

[Install]
WantedBy=multi-user.target
