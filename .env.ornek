# EkipTakip — ortam degiskenleri.
#
#   cp .env.ornek .env    ve degerleri doldur.  .env GIT'E GIRMEZ.
#   Degerleri buraya YAZMA: bu dosya depoda, yalnizca isimler durur.

# --- kimlik (spec/70-guvenlik.md) ----------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Yetkili redirect URI'lar (iki site icin ayri ayri):
#   https://dashboard.<alan>/login/callback
#   https://app.<alan>/login/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Oturum imzasi. Uret:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Degistirirsen HERKESIN oturumu duser (acil durum dugmesi).
EKIPTAKIP_SECRET_KEY=

# Gelistirme icin gercek giris yerine ilk kullaniciyla calis.
# Yayin kurulumunda (alan adi tanimliyken) acilisi REDDEDER.
# EKIPTAKIP_AUTH=sahte

# Yayin kurulumu mu? Alan adi tanimlamak da ayni etkiyi yapar, ama acikca yaz:
# kurallar sertlesir (sahte kimlik reddedilir, kisa anahtar reddedilir, cerez
# __Secure- onekli ve yalnizca HTTPS olur).
# EKIPTAKIP_ENV=yayin

# --- alan adlari ----------------------------------------------------------
# Bos birakilirsa tek alan adi modu: masaustu /, mobil /m
# EKIPTAKIP_HOST_APP=app.polonyum.com
# EKIPTAKIP_HOST_DASHBOARD=dashboard.polonyum.com
# EKIPTAKIP_COOKIE_DOMAIN=.polonyum.com

# --- medya ekleri (spec/20-sema.md §3b) -----------------------------------
# Duz POSIX yol; uygulama SMB konusmaz. Bos birakilirsa depo icinde
# var/media kullanilir (gelistirme icin yeterli, .gitignore'da).
#
# Konteyner disinda (yerel .venv ile calisirken) uygulamanin KENDISININ
# okudugu deger budur:
# EKIPTAKIP_MEDIA_ROOT=/home/efe/sata/ekiptakip/media
#
# --- veritabani (PostgreSQL) ---------------------------------------------
# Gelistirmede docker-compose.yml'deki varsayilan kullanilir:
#   postgresql://ekiptakip:ekiptakip@127.0.0.1:5432/ekiptakip
# Yayinda PAROLA BURADA durur ve bu dosya git'e girmez:
# DATABASE_URL=postgresql://ekiptakip:GERCEK_PAROLA@127.0.0.1:5432/ekiptakip

# --- konteyner yigini (docker-compose.prod.yml) --------------------------
# Yalnizca `docker compose -f docker-compose.prod.yml` kullanirken gerekli.
#
# POSTGRES_PASSWORD ZORUNLU: verilmezse yigin acilmaz. Gelistirmedeki
# "ekiptakip" parolasini bir sunucuya tasima. Uret:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
# POSTGRES_PASSWORD=
# POSTGRES_USER=ekiptakip
# POSTGRES_DB=ekiptakip

# Uygulamanin ana makinedeki portu. nginx buraya proxy_pass eder
# (deploy/nginx-ekiptakip-docker.conf). Yalnizca 127.0.0.1'e baglanir.
# APP_PORT=8001

# Medya eklerinin ANA MAKINEDEKI yolu (docker-compose.prod.yml bunu
# /data/media'ya bind mount eder; konteyner icindeki EKIPTAKIP_MEDIA_ROOT
# compose dosyasinda sabit, buradan degismez). Verilmezse `./var/media`
# kullanilir — yani compose'un calistigi dizine gore bir dizin, TEK
# MAKINELIK denemede yeter ama gercek kurulumda MUTLAKA gercek diske
# (Pi'de SATA) isaret etmeli. Isimli bir Docker volume DEGIL, gercek bir
# host yolu olmasi bilerek: NixOS tarafinda bu deger
# systemd.services.ekiptakip'e EKIPTAKIP_MEDIA_DIR olarak geciriliyor
# (deploy/nix-ekiptakip-media.nix) — .env'e BURAYA yazmana gerek yok, o
# akis .env'i degil dogrudan surec ortamini kullanir; bu satir yalnizca
# `docker compose` KOMUT SATIRINDAN elle calistiranlar icin.
# EKIPTAKIP_MEDIA_DIR=/home/efe/sata/ekiptakip/media

# NOT: yigin calisirken DATABASE_URL compose tarafindan EZILIR — konteynerler
# arasinda ana makine adi 'db'dir, 127.0.0.1 degil. Buradaki deger yalnizca
# konteyner disindan (yerel .venv ile) baglanirken kullanilir.
