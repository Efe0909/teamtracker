# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Medya ekleri: gelistirmede MEDIA_ROOT varsayilani burasi. Kullanicilarin
# yukledigi gorseller birikir — veritabani gibi, ASLA commit etme. Yayinda bu
# dizin kullanilmaz; orada bind-mount /data/media var (deploy/DOCKER.md).
var/

# Veritabani: gercek kart icerigi ve kullanici e-postalari birikir, ASLA commit etme
*.db
*.db-journal
*.db-wal
*.db-shm

# Sirlar: oturum anahtari, Google OAuth istemcisi, VAPID
# (.env.ornek depoda durur — isimler var, degerler yok)
.env*
!.env.ornek

# spec: ham ekran goruntuleri — depo public, yapiyi yaz goruntuyu koyma
spec/gorseller/

# deploy: kur.sh ciktilari (makineye ozel yollar)
deploy/olusan/

# isletim sistemi
.DS_Store
